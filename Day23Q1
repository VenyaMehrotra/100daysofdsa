#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node* next;
};

int main() {
    int n, m, value;
    
    struct node *head1 = NULL, *head2 = NULL;
    struct node *temp = NULL, *newNode;
    scanf("%d", &n);
    
    for(int i = 0; i < n; i++) {
        scanf("%d", &value);
        
        newNode = (struct node*)malloc(sizeof(struct node));
        if(newNode == NULL) {
            printf("Memory Overflow\n");
            return 0;
        }
        
        newNode->data = value;
        newNode->next = NULL;
        
        if(head1 == NULL) {
            head1 = newNode;
            temp = newNode;
        } else {
            temp->next = newNode;
            temp = newNode;
        }
    }
    
    scanf("%d", &m);
    temp = NULL;
    for(int i = 0; i < m; i++) {
        scanf("%d", &value);
        
        newNode = (struct node*)malloc(sizeof(struct node));
        if(newNode == NULL) {
            printf("Memory Overflow\n");
            return 0;
        }
        
        newNode->data = value;
        newNode->next = NULL;
        
        if(head2 == NULL) {
            head2 = newNode;
            temp = newNode;
        } else {
            temp->next = newNode;
            temp = newNode;
        }
    }
    
    struct node dummy;
    struct node *tail = &dummy;
    dummy.next = NULL;
    
    while(head1 != NULL && head2 != NULL) {
        if(head1->data <= head2->data) {
            tail->next = head1;
            head1 = head1->next;
        } else {
            tail->next = head2;
            head2 = head2->next;
        }
        tail = tail->next;
    }
    
    if(head1 != NULL)
        tail->next = head1;
    else
        tail->next = head2;
  
    struct node *result = dummy.next;
    
    while(result != NULL) {
        printf("%d ", result->data);
        result = result->next;
    }
    
    return 0;
}
