#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, m;
    scanf("%d", &n);
    
    int stack[n];   
    int top = -1;   
    for(int i = 0; i < n; i++) {
        int value;
        scanf("%d", &value);
        top++;
        stack[top] = value;
    }
    scanf("%d", &m);
    for(int i = 0; i < m; i++) {
        if(top == -1) {
            break;  
        }
        top--;
    }
    for(int i = top; i >= 0; i--) {
        printf("%d ", stack[i]);
    }
    return 0;
}
