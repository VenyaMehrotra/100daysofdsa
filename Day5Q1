#include <stdio.h>
int main()
 {
    int n1, n2, i, j, temp;
    scanf("%d", &n1);
    int arr1[n1];
    for (i=0;i<n1;i++) 
    {
        scanf("%d", &arr1[i]);
    }
    scanf("%d", &n2);
    int arr2[n2];
    for (i=0;i<n2;i++) 
    {
        scanf("%d", &arr2[i]);
    }
    int arr3[n1 + n2];
    for (i=0;i<n1;i++) 
    {
        arr3[i]=arr1[i];
    }
    for (i=0;i<n2;i++) 
    {
        arr3[n1+i]=arr2[i];
    }
    for (i=0;i<n1+n2-1;i++) 
    {
        for (j=0;j<n1+n2-i-1;j++) 
        {
            if (arr3[j]>arr3[j+1]) 
            {
                temp = arr3[j];
                arr3[j] = arr3[j+1];
                arr3[j+1] = temp;
            }
        }
    }
    for (i=0;i<n1+n2;i++) 
    {
        printf("%d ",arr3[i]);
    }
    return 0;
}
