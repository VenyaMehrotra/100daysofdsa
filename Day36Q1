#include <stdio.h>
#include <stdlib.h>
int main() {
    int n, m;
    scanf("%d", &n);
    int *queue = (int*)malloc(sizeof(int) * n);
    
  
    for (int i = 0; i < n; i++) {
        scanf("%d", &queue[i]);
    }
    
    scanf("%d", &m);
    
    int front = 0;
    int size = n;
    for (int i = 0; i < m; i++) {
        if (size > 0) {
            front = (front + 1) % n;
            size--;
        }
    }
    for (int i = 0; i < size; i++) {
        int index = (front + i) % n;
        printf("%d ", queue[index]);
    }
    
    free(queue);
    return 0;
}
