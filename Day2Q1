#include <stdio.h>
int main() {
    int n, pos;
    printf("Enter the number of elements=");
    scanf("%d", &n);
    int arr[n];
    for(int i = 0; i < n; i++) 
    {
        printf("Enter the elements=");
        scanf("%d", &arr[i]);
    }
    scanf("%d", &pos);
    for(int i = pos - 1; i < n - 1; i++) 
    {
        printf("Enter the element you want to delete=");
        arr[i] = arr[i + 1];
    }
    for(int i = 0; i < n - 1; i++) {
        printf("%d ", arr[i]);
    }
    return 0;
}

