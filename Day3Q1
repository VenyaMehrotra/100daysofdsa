#include<stdio.h>
int main()
{
    int i,arr[50],n,count=0,element;
    scanf("%d",&n);
    for(i=0;i<n;i++)
    {
    scanf("%d",&arr[i]);
    }
    scanf("%d",&element);
    for(i=0;i<n;i++)
    {
    if(arr[i]==element)
    {
        printf("Found at index %d \n",i);
        printf("Comparisons=%d",count+1);
    }
    else
    {
        count++;
    }
    }
    if(count==n)
    {
        printf("Not found");
    }
    return 0;
}
