#include <stdio.h>
#include <stdlib.h>

int *stack;
int top = -1;
int capacity;

// Push Operation
void push(int value) {
    if (top == capacity - 1) {
        printf("Stack Overflow\n");
        return;
    }
    stack[++top] = value;
}

// Pop Operation
void pop() {
    if (top == -1) {
        printf("Stack Underflow\n");
        return;
    }
    printf("%d\n", stack[top--]);
}

// Display Operation (Top to Bottom)
void display() {
    if (top == -1) {
        printf("Stack is Empty\n");
        return;
    }
    for (int i = top; i >= 0; i--) {
        printf("%d ", stack[i]);
    }
    printf("\n");
}

int main() {
    int n;
    scanf("%d", &n);

    capacity = n;   // maximum possible pushes = number of operations
    stack = (int *)malloc(capacity * sizeof(int));

    for (int i = 0; i < n; i++) {
        int operation;
        scanf("%d", &operation);

        if (operation == 1) {
            int value;
            scanf("%d", &value);
            push(value);
        }
        else if (operation == 2) {
            pop();
        }
        else if (operation == 3) {
            display();
        }
    }

    free(stack);
    return 0;
}
